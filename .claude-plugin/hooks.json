{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/registry/scripts/install.js\"",
            "async": false
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "TOOL=$(command -v alcove 2>/dev/null); test -n \"$TOOL\" && \"$TOOL\" reap || echo '[alcove] not found, skipping'",
            "async": true
          }
        ]
      }
    ]
  }
}
